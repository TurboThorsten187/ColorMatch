        "@types/node": "^22.20.5",
        "@vite-pwa/assets-generator": "^2.0.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.7",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.0.5",

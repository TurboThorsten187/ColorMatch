{
    "name": "colormatch",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:e2e": "vite build --mode e2e --outDir dist-e2e",
        "preview": "vite preview",
        "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p e2e && tsc -p tsconfig.sw.json",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
        "check": "npm run lint && npm run typecheck && npm test && npm run build",
        "android:sync": "npm run build && cap sync android",
        "android:open": "cap open android",
        "android:run": "cap run android"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.3",
        "@eslint/js": "^10.0.1",
